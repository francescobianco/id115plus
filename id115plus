#!/usr/bin/env bash
# Control an ID115 Plus fitness band (MSLM707) (Yoho Sports / uThink protocol) over BLE via BlueZ D-Bus.
#
# Usage:
#   ./id115plus info                       device name, firmware and feature flags (cc02)
#   ./id115plus battery                    battery level and charging state (cc03)
#   ./id115plus settime                    set band clock to local time (04 00)
#   ./id115plus find                       "find band" vibration (08 01)
#   ./id115plus notify [-t type] <text>    notification, up to 48 characters (F2 <type>)
#                                      types: sms wechat qq facebook twitter whatsapp (default)
#                                             instagram line
#   ./id115plus call [-s seconds] <caller> incoming call, ended after N s (default 10) (F2 03)
#   ./id115plus alarms [file]              program alarms from a weekly matrix (default alarms.txt)
#   ./id115plus vibration on|off           vibration on notifications (01)
#   ./id115plus longsit on|off [minutes]   sedentary reminder, interval default 60 min (07)
#   ./id115plus selfie on|off              remote camera mode: shake the band to shoot (09)
#   ./id115plus profile [key=value...]     user profile (F1 01): gender=male|female age= height=cm
#                                      weight=kg steps=goal unit=km|mi hand=left|right
#   ./id115plus display [key=value...]     display settings (F1 02): format=time|datetime
#                                      lift=on|off lang=en|it|de|fr|es|... bp=on|off
#   ./id115plus live [seconds]             print live events: steps, selfie, sedentary, find phone
#                                      (cc04, default 60 s, 0 = until Ctrl+C)
#   ./id115plus sync                       download stored activity records (F4); the band
#                                      deletes them once confirmed
#   ./id115plus reset --yes                restore factory settings (F1 03 18 01)
#   ./id115plus raw <hex> [<hex>...]       write raw commands to cc06 (no padding)
#   ./id115plus read <uuid>                read a characteristic, e.g. cc03 or full UUID
#   ./id115plus ota-probe [seconds]        read-only: enable notify on fd02 and print what the
#                                      band announces over the Maxscend OTA channel (no writes)
#   ./id115plus ota-flash <img> [opts]     flash a firmware OTA image over fd00/fd01/fd02.
#                                      default = handshake only (writes NOTHING to flash);
#                                      --dry-run = stream with a wrong crc32 (device rejects;
#                                      needs --yes); --commit --yes = the real flash (can brick).
#                                      See: ./id115plus ota-flash --help
#   ./id115plus status                     link state as seen by BlueZ and by the controller
#   ./id115plus keepalive [seconds]        hold the connection, probing every N s (default 10)
#                                      and reconnecting on failure, until Ctrl+C
#
# Every connect, read and write recovers on its own: reconnect, then a forced disconnect,
# then an adapter power cycle (no sudo), retried up to RETRIES times.
#
# Env: MAC (default BA:03:5C:05:4A:12), RETRIES (default 5), HCI (default hci0)

set -u

MAC=${MAC:-BA:03:5C:05:4A:12}
RETRIES=${RETRIES:-5}
HCI=${HCI:-hci0}

DEV=/org/bluez/$HCI/dev_${MAC//:/_}
CHAR=org.bluez.GattCharacteristic1

prop() { busctl get-property org.bluez "$DEV" org.bluez.Device1 "$1" 2>/dev/null | awk '{print $2}'; }

log() { echo "$(date +%T) $*" >&2; }

# True when the controller really has a link to the band. bluetoothd can keep reporting
# Connected/ServicesResolved after the link is gone, and then every GATT call fails with
# "Not connected" while Disconnect times out.
linked() {
  if command -v hcitool >/dev/null; then
    hcitool -i "$HCI" con 2>/dev/null | grep -qi "$MAC"
  else
    [[ $(prop Connected) == true ]]
  fi
}

ready() { [[ $(prop ServicesResolved) == true ]] && linked; }

# Reset the link state. Level 1: Disconnect. Level 2: also power cycle the adapter, the only
# thing that clears a stale connection without sudo (same as bluetoothctl power off/on).
recover() {
  local ad=/org/bluez/$HCI
  log "recover: disconnect"
  busctl --timeout=10 call org.bluez "$DEV" org.bluez.Device1 Disconnect >/dev/null 2>&1
  sleep 1
  if (( $1 >= 2 )) || [[ $(prop Connected) == true ]]; then
    log "recover: power cycle $HCI"
    busctl set-property org.bluez "$ad" org.bluez.Adapter1 Powered b false 2>/dev/null
    sleep 2
    busctl set-property org.bluez "$ad" org.bluez.Adapter1 Powered b true 2>/dev/null
    sleep 2
  fi
}

# Try to bring the link up, escalating recovery on each failed attempt. Returns 1 on failure.
try_connect() {
  local r i
  ready && return 0
  for ((r = 1; r <= RETRIES; r++)); do
    # attempt 1: plain connect; 2: disconnect first; 3+: power cycle the adapter first
    (( r > 1 )) && recover $((r - 1))
    busctl --timeout=30 call org.bluez "$DEV" org.bluez.Device1 Connect >/dev/null 2>&1
    for ((i = 0; i < 20; i++)); do
      ready && { (( r > 1 )) && log "connected (attempt $r)"; return 0; }
      sleep 0.5
    done
    log "attempt $r/$RETRIES failed, retrying..."
  done
  log "giving up after $RETRIES attempts"
  return 1
}

connect() { try_connect || exit 1; }

# Run a GATT call on a characteristic with recovery: on failure reconnect and retry.
# Usage: gatt <uuid> <method> <signature> <args...>; prints busctl output.
gatt() {
  local uuid=$1 r out
  shift
  for ((r = 1; r <= RETRIES; r++)); do
    if try_connect && out=$(busctl --timeout=15 call org.bluez "$(char_path "$uuid")" $CHAR "$@" 2>&1); then
      echo "$out"; return 0
    fi
    log "$uuid $1 failed (${out:-no link}), recovering $r/$RETRIES"
    # a failed call on a "connected" device means the state is stale: force a reset
    recover $(( r > 1 ? 2 : 1 ))
    out=
  done
  return 1
}

# D-Bus path of a characteristic, by short (cc06) or full UUID.
char_path() {
  local uuid=${1,,} p
  [[ ${#uuid} -eq 4 ]] && uuid=0000$uuid-0000-1000-8000-00805f9b34fb
  for p in $(busctl tree --list org.bluez | grep "^$DEV/service[0-9a-f]*/char[0-9a-f]*$"); do
    if [[ $(busctl get-property org.bluez "$p" $CHAR UUID) == "s \"$uuid\"" ]]; then
      echo "$p"; return 0
    fi
  done
  echo "characteristic $1 not found" >&2
  exit 1
}

# Read a characteristic; prints bytes as space-separated decimal.
read_char() {
  local out
  out=$(gatt "$1" ReadValue 'a{sv}' 0) || { echo "read failed: $1" >&2; exit 1; }
  cut -d' ' -f3- <<< "$out"
}

# Write each hex string as one packet to cc06, waiting for the write response.
write_cmds() {
  local cmd bytes
  for cmd in "$@"; do
    cmd=${cmd// /}
    [[ $cmd =~ ^([0-9a-fA-F]{2})+$ ]] || { echo "bad hex: $cmd" >&2; exit 2; }
    bytes=$(printf '%s' "$cmd" | sed 's/../0x& /g')
    # shellcheck disable=SC2086
    gatt cc06 WriteValue 'aya{sv}' $((${#cmd} / 2)) $bytes 1 type s request >/dev/null ||
      { echo "write failed: $cmd" >&2; exit 1; }
  done
}

# Packets for a text push: F2 <type> <total chars> <seq> <8 chars UTF-16LE, zero padded to 16 bytes>
push_cmds() {
  local type=$1 text=$2 i chunk
  for ((i = 0; i * 8 < ${#text}; i++)); do
    chunk=$(printf '%s' "${text:i*8:8}" | iconv -t UTF-16LE | xxd -p | tr -d '\n')
    printf 'f2%s%02x%02x%-32s\n' "$type" ${#text} $i "$chunk" | tr ' ' 0
  done
}

# on|off argument as 1|0
onoff() {
  case ${1:-} in on) echo 1 ;; off) echo 0 ;; *) echo "expected on|off, got: ${1:-}" >&2; exit 2 ;; esac
}

# Parse key=value arguments into the associative array named by $1, allowing only its existing keys.
parse_kv() {
  local -n kv=$1
  local arg
  shift
  for arg in "$@"; do
    [[ $arg == *=* && -n ${kv[${arg%%=*}]+x} ]] || { echo "unknown option: $arg" >&2; exit 2; }
    kv[${arg%%=*}]=${arg#*=}
  done
}

# Subscribe to cc04 notifications and handle them: "live" prints events, "sync" runs the
# F4 record download handshake. Exits after the given seconds without packets (0 = never).
# If the link drops, the listener exits with 3 and is restarted after reconnecting.
listen() {
  local rc
  while :; do
    connect
    listener "$@"
    rc=$?
    (( rc == 3 )) || return $rc
    log "link lost, reconnecting"
    recover 1
  done
}

listener() {
  python3 - "$1" "$DEV" "$2" <<'PY'
import sys, datetime, dbus, dbus.mainloop.glib
from gi.repository import GLib

mode, dev, secs = sys.argv[1], sys.argv[2], int(sys.argv[3])
dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
objs = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
paths = {str(i["org.bluez.GattCharacteristic1"]["UUID"])[4:8]: p for p, i in objs.items()
         if p.startswith(dev + "/") and "org.bluez.GattCharacteristic1" in i}
char = lambda u: dbus.Interface(bus.get_object("org.bluez", paths[u]), "org.bluez.GattCharacteristic1")
rt, ctl = char("cc04"), char("cc06")
loop = GLib.MainLoop()
timer = None
base = None
lost = False


def write(*b):
    ctl.WriteValue(dbus.Array([dbus.Byte(x) for x in b], signature="y"), {"type": "request"})


def rearm():
    global timer
    if timer:
        GLib.source_remove(timer)
    timer = GLib.timeout_add_seconds(secs, loop.quit) if secs else None


def now():
    return datetime.datetime.now().strftime("%H:%M:%S")


def u16(v, o):
    return v[o] | v[o + 1] << 8


def stamp(v, o):
    # yy mm dd HH MM SS
    return datetime.datetime(2000 + v[o], v[o + 1], v[o + 2], v[o + 3], v[o + 4], v[o + 5])


def on_live(v):
    if v[0] == 0xF3 and v[1] == 0x18:
        print(f"{now()}  find phone")
        write(0xF3, 0x18)
        return
    if v[0] in (0xF1, 0xF3, 0xF4, 0xF5):
        print(f"{now()}  packet {v.hex(' ')}")
        return
    flags = u16(v, 0)
    if flags == 0x80 or flags >> 6 & 1:
        return  # sleep / raw accelerometer logs
    if flags >> 3 & 1:
        print(f"{now()}  selfie")
    elif flags >> 2 & 1:
        print(f"{now()}  sedentary reminder")
    elif flags >> 5 & 1:
        print(f"{now()}  heart rate {v[10]}")
    else:
        print(f"{now()}  state {v[2]}  steps {int.from_bytes(v[3:7], 'little')}")


def on_sync(v):
    global base
    if v[0] != 0xF4:
        return
    if v[1] == 1:
        # base time of the stored records, all zero when there are none
        base = stamp(v, 2) if any(v[2:8]) else None
        print(f"records since {base:%Y-%m-%d %H:%M:%S}" if base else "no stored records")
        write(0xF4, 1)
    elif v[1] == 2:
        # <seq u16> <count> then <state> <minutes from base u16> <steps u16> per record
        for i in range(v[4]):
            o = 5 + 5 * i
            t = base + datetime.timedelta(minutes=u16(v, o + 1)) if base else None
            print(f"{t:%Y-%m-%d %H:%M}  state {v[o]}  steps {u16(v, o + 3)}" if t else
                  f"+{u16(v, o + 1)} min  state {v[o]}  steps {u16(v, o + 3)}")
        write(0xF4, 2, v[2], v[3])
    elif v[1] == 3:
        print(f"current state {v[2]} since {stamp(v, 7):%Y-%m-%d %H:%M:%S}  steps {u16(v, 5)}")
        write(0xF4, 3)
        loop.quit()


handler = on_live if mode == "live" else on_sync


def changed(iface, props, invalidated):
    if "Value" in props:
        rearm()
        handler(bytes(props["Value"]))
        sys.stdout.flush()


def device_changed(iface, props, invalidated):
    global lost
    if props.get("Connected") is False or props.get("ServicesResolved") is False:
        lost = True
        loop.quit()


bus.add_signal_receiver(changed, "PropertiesChanged", "org.freedesktop.DBus.Properties",
                        "org.bluez", paths["cc04"])
bus.add_signal_receiver(device_changed, "PropertiesChanged", "org.freedesktop.DBus.Properties",
                        "org.bluez", dev)
rt.StartNotify()
if mode == "sync":
    write(0xF4, 0)
rearm()
try:
    loop.run()
except KeyboardInterrupt:
    pass
finally:
    try:
        rt.StopNotify()
    except dbus.DBusException:
        pass
sys.exit(3 if lost else 0)
PY
}

# Read-only OTA probe: enable notifications on the Maxscend OTA cmd characteristic (fd02) and
# print whatever the band announces (its version info, etc.). NO firmware commands are ever
# written: StartNotify only writes the standard CCCD, nothing is sent on fd01/fd02. Safe.
ota_probe() {
  connect
  python3 - "$DEV" "${1:-20}" <<'PY'
import sys, datetime, dbus, dbus.mainloop.glib
from gi.repository import GLib

dev, secs = sys.argv[1], int(sys.argv[2])
dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
objs = dbus.Interface(bus.get_object("org.bluez", "/"),
                      "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
paths = {str(i["org.bluez.GattCharacteristic1"]["UUID"])[4:8]: p for p, i in objs.items()
         if p.startswith(dev + "/") and "org.bluez.GattCharacteristic1" in i}
for u in ("fd01", "fd02"):  # fd00 is the service UUID, not a characteristic
    print(f"{u}: {'present' if u in paths else 'MISSING'}")
if "fd02" not in paths:
    sys.exit("fd02 (Maxscend OTA cmd) not found on this device")
fd02 = dbus.Interface(bus.get_object("org.bluez", paths["fd02"]), "org.bluez.GattCharacteristic1")
loop = GLib.MainLoop()


def now():
    return datetime.datetime.now().strftime("%H:%M:%S")


def decode(v):
    # the app parses MxdVersionInfo from a notification with value[1]==1, bytes [2..9]:
    # projId u16LE, boot, stack, app u16LE, appStack, appBoot
    if len(v) >= 10 and v[1] == 1:
        projId = v[2] | v[3] << 8
        app = v[6] | v[7] << 8
        return (f"VERSION  projId=0x{projId:04x} boot={v[4]} stack={v[5]} "
                f"app=0x{app:04x} appStack={v[8]} appBoot={v[9]}")
    if len(v) >= 3 and v[1] == 2:
        return f"READY  ({'go 0x55' if v[2] == 0x55 else f'byte2=0x{v[2]:02x}'})"
    if len(v) >= 2 and v[1] == 3:
        return "CRC RESULT"
    return "(unrecognized)"


def changed(iface, props, invalidated):
    if "Value" in props:
        v = bytes(props["Value"])
        print(f"{now()}  fd02 <- {v.hex(' ')}   {decode(v)}")
        sys.stdout.flush()


bus.add_signal_receiver(changed, "PropertiesChanged", "org.freedesktop.DBus.Properties",
                        "org.bluez", paths["fd02"])
fd02.StartNotify()
print(f"{now()}  notifications enabled on fd02; listening {secs}s (read-only, no writes)...")
GLib.timeout_add_seconds(secs, loop.quit)
try:
    loop.run()
finally:
    try:
        fd02.StopNotify()
    except dbus.DBusException:
        pass
PY
}

# Maxscend OTA firmware flash (fd00/fd01/fd02). Drives the state machine reverse-engineered in
# docs/ota-protocol.md. THREE safety levels, chosen by mode:
#   handshake  (default) version read + cmd 01 + cmd 02 only. NO bytes on fd01, NO cmd 03.
#              Writes NOTHING to flash: a pure compatibility probe. Cannot brick.
#   dry-run    full stream but cmd 03 carries a DELIBERATELY WRONG crc32 -> the device must
#              reject at commit, leaving the running firmware intact IF the bootloader stages
#              (see docs/ota-flash-runbook.md: this is the staging test; needs --yes).
#   commit     the real flash: valid crc32, device verifies and reboots onto our image.
#              Needs --yes. THIS is the one that can brick. Do it only on the owner's go.
ota_flash() {
  local image=$1 mode=$2 yes=$3
  [[ -f $image ]] || { echo "image not found: $image" >&2; exit 2; }
  if [[ $mode != handshake && $yes != --yes ]]; then
    echo "mode '$mode' writes to the device; refusing without --yes (see: $0 ota-flash --help)" >&2
    exit 2
  fi
  connect
  python3 - "$DEV" "$image" "$mode" <<'PY'
import sys, time, datetime, dbus, dbus.mainloop.glib
from gi.repository import GLib

dev, image_path, mode = sys.argv[1], sys.argv[2], sys.argv[3]
CHUNK = 20            # fd01 payload per write (ATT MTU 23 - 3), as the app uses
PACE_MS = 12          # delay between data chunks (write-without-response has no flow control)

with open(image_path, "rb") as f:
    img = f.read()
if len(img) < 16:
    sys.exit("image too short: no 16-byte header")
hdr, code = img[:16], img[16:]
projId  = hdr[0] | hdr[1] << 8
f_boot, f_stack = hdr[2], hdr[3]
f_app   = hdr[4] | hdr[5] << 8
f_appStack, f_appBoot = hdr[6], hdr[7]
codeSize = int.from_bytes(hdr[8:12], "little")
crc32    = hdr[12:16]

def now(): return datetime.datetime.now().strftime("%H:%M:%S")
print(f"{now()}  image: {image_path}")
print(f"         header projId=0x{projId:04x} boot={f_boot} stack={f_stack} app=0x{f_app:04x} "
      f"appStack={f_appStack} appBoot={f_appBoot} codeSize={codeSize} crc32={crc32.hex()}")
print(f"         code bytes present={len(code)} (header says codeSize={codeSize})")
if len(code) != codeSize:
    print(f"{now()}  WARNING: code length {len(code)} != header codeSize {codeSize}")
print(f"{now()}  MODE: {mode}")

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
objs = dbus.Interface(bus.get_object("org.bluez", "/"),
                      "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
paths = {str(i["org.bluez.GattCharacteristic1"]["UUID"])[4:8]: p for p, i in objs.items()
         if p.startswith(dev + "/") and "org.bluez.GattCharacteristic1" in i}
for u in ("fd01", "fd02"):
    if u not in paths:
        sys.exit(f"{u} not found: this is not a Maxscend-OTA device")
fd01 = dbus.Interface(bus.get_object("org.bluez", paths["fd01"]), "org.bluez.GattCharacteristic1")
fd02 = dbus.Interface(bus.get_object("org.bluez", paths["fd02"]), "org.bluez.GattCharacteristic1")
loop = GLib.MainLoop()

def wr(ch, *b):
    ch.WriteValue(dbus.Array([dbus.Byte(x) for x in b], signature="y"), {"type": "command"})

def wrbytes(ch, bs):
    ch.WriteValue(dbus.Array([dbus.Byte(x) for x in bs], signature="y"), {"type": "command"})

state = {"ver": None, "sent01": False, "sent02": False, "ready": False,
         "idx": 0, "sent03": False, "done": False}

def send_cmd01():
    v = state["ver"]
    # app byte order: 01 projId_lo projId_hi devBoot devStack app_lo app_hi devAppStack devAppBoot
    pkt = [0x01, projId & 0xff, projId >> 8, v["boot"], v["stack"],
           f_app & 0xff, f_app >> 8, v["appStack"], v["appBoot"]]
    wr(fd02, *pkt)
    state["sent01"] = True
    print(f"{now()}  -> fd02 cmd01 version  {bytes(pkt).hex(' ')}")

def send_cmd02():
    pkt = [0x02] + list(hdr[8:12])
    wr(fd02, *pkt)
    state["sent02"] = True
    print(f"{now()}  -> fd02 cmd02 codeSize {bytes(pkt).hex(' ')}")
    if mode == "handshake":
        print(f"{now()}  handshake complete: version + cmd01 + cmd02 sent, NO flash written.")
        print(f"{now()}  (a 'READY 0x55' below would confirm the device accepts us; it may only")
        print(f"{now()}   arrive once data starts, which handshake mode never does.)")
        GLib.timeout_add_seconds(4, loop.quit)
        return
    # dry-run / commit: start the data phase with the first chunk, then stream on ready
    send_chunk()

def send_chunk():
    i = state["idx"]
    if i >= len(code):
        return False
    part = code[i:i + CHUNK]
    wrbytes(fd01, part)
    state["idx"] += len(part)
    if state["idx"] % 2000 < CHUNK or state["idx"] >= len(code):
        print(f"{now()}  -> fd01 data {state['idx']}/{len(code)} bytes", flush=True)
    return True

def stream_tick():
    if not state["ready"]:
        return True  # keep waiting for the device's go
    if state["idx"] < len(code):
        send_chunk()
        return True
    if not state["sent03"]:
        send_cmd03()
    return False  # stop the timer

def send_cmd03():
    c = bytearray(crc32)
    if mode == "dry-run":
        c[0] ^= 0xFF  # deliberately wrong crc -> device must reject, firmware stays (if staging)
        print(f"{now()}  dry-run: corrupting crc32 {crc32.hex()} -> {bytes(c).hex()} (device should REJECT)")
    pkt = [0x03] + list(c)
    wr(fd02, *pkt)
    state["sent03"] = True
    print(f"{now()}  -> fd02 cmd03 crc32    {bytes(pkt).hex(' ')}")
    GLib.timeout_add_seconds(6, loop.quit)

def on_notify(iface, props, inv):
    if "Value" not in props:
        return
    v = bytes(props["Value"])
    print(f"{now()}  <- fd02 {v.hex(' ')}", flush=True)
    if len(v) >= 10 and v[1] == 1:
        state["ver"] = {"projId": v[2] | v[3] << 8, "boot": v[4], "stack": v[5],
                        "app": v[6] | v[7] << 8, "appStack": v[8], "appBoot": v[9]}
        print(f"{now()}     device VERSION projId=0x{state['ver']['projId']:04x} boot={v[4]} "
              f"stack={v[5]} app=0x{state['ver']['app']:04x} appStack={v[8]} appBoot={v[9]}")
        if not state["sent01"]:
            send_cmd01()
            send_cmd02()
    elif len(v) >= 3 and v[1] == 2 and v[2] == 0x55:
        print(f"{now()}     device READY (0x55): accepts our version, ready for data")
        state["ready"] = True
        if mode != "handshake" and not state["sent03"]:
            GLib.timeout_add(PACE_MS, stream_tick)
    elif len(v) >= 2 and v[1] == 3:
        # CRC verdict from the device. The stock app ignores value[2], so its exact meaning is
        # unknown: record the raw bytes and let the runbook interpret (dry-run expects a reject).
        print(f"{now()}     device CRC RESULT (raw): {v.hex(' ')}  "
              f"[value[2]=0x{v[2]:02x}]" if len(v) >= 3 else f"{now()}     device CRC RESULT (raw): {v.hex(' ')}")
        state["done"] = True
        GLib.timeout_add_seconds(2, loop.quit)

bus.add_signal_receiver(on_notify, "PropertiesChanged", "org.freedesktop.DBus.Properties",
                        "org.bluez", paths["fd02"])
# StartNotify can time out on a weak link; retry rather than abort (a mid-OTA abort is safe:
# the device rolls back if it never gets a valid image, but we still want it to actually start).
for attempt in range(1, 7):
    try:
        fd02.StartNotify()
        break
    except dbus.DBusException as e:
        print(f"{now()}  StartNotify attempt {attempt}/6 failed ({e.get_dbus_name() or e}); retrying")
        time.sleep(1.5)
else:
    sys.exit("could not enable fd02 notifications (link too weak?) — bring the band closer")
print(f"{now()}  notify enabled on fd02; waiting for device version announcement...")
GLib.timeout_add_seconds(45, loop.quit)  # overall safety timeout
try:
    loop.run()
finally:
    try: fd02.StopNotify()
    except dbus.DBusException: pass
print(f"{now()}  ota-flash finished (mode={mode}).")
PY
}

case ${1:-} in
  info)
    read -r -a b <<< "$(read_char cc02)"
    # firmware = bytes 12.13.14.11; feature flags in bytes 15..18
    printf 'name %s  firmware %02x.%02x.%02x.%02x  flags %02x %02x %02x %02x\n' "$(prop Name | tr -d '"')" \
      "${b[12]}" "${b[13]}" "${b[14]}" "${b[11]}" "${b[15]}" "${b[16]}" "${b[17]}" "${b[18]}"
    has() { (( $1 >> $2 & 1 )) && printf '%s ' "$3"; }
    printf 'features: '
    has "${b[15]}" 0 kmd; has "${b[15]}" 1 multi-sport; has "${b[15]}" 2 hr-bp-sync; has "${b[15]}" 7 watchface
    has "${b[16]}" 1 weather; has "${b[16]}" 4 music; has "${b[16]}" 5 hid; has "${b[16]}" 7 bt-audio
    has "${b[17]}" 2 temperature; has "${b[17]}" 4 heart-rate; has "${b[17]}" 5 blood-pressure
    has "${b[18]}" 0 contacts
    echo ;;
  battery)
    read -r -a b <<< "$(read_char cc03)"
    # byte 0 = percentage, byte 7 = state
    case ${b[7]} in 0) st=normal ;; 1) st=charging ;; 2) st=charged ;; 3) st="not charging" ;; *) st="state ${b[7]}" ;; esac
    echo "${b[0]}%  $st" ;;
  settime)
    read -r y m d H M S <<< "$(date '+%y %m %d %H %M %S')"
    # 04 00 <year-2000> <month> <day> <hour> <min> <sec>
    write_cmds "$(printf '0400%02x%02x%02x%02x%02x%02x' $((10#$y)) $((10#$m)) $((10#$d)) $((10#$H)) $((10#$M)) $((10#$S)))"
    echo "clock set to $(date '+%Y-%m-%d %H:%M:%S')" ;;
  find)
    write_cmds 0801 ;;
  notify)
    shift
    type=whatsapp
    if [[ ${1:-} == -t ]]; then type=${2:-}; shift 2; fi
    declare -A types=([sms]=10 [wechat]=11 [qq]=12 [facebook]=13 [twitter]=14 [whatsapp]=15 [instagram]=16 [line]=17)
    [[ -n ${types[$type]:-} ]] || { echo "unknown type: $type" >&2; exit 2; }
    [[ $# -ge 1 ]] || { echo "usage: $0 notify [-t type] <text>" >&2; exit 2; }
    text="$*"
    (( ${#text} <= 48 )) || { echo "text truncated to 48 characters" >&2; text=${text:0:48}; }
    mapfile -t cmds < <(push_cmds "${types[$type]}" "$text")
    write_cmds "${cmds[@]}" ;;
  call)
    shift
    secs=10
    if [[ ${1:-} == -s ]]; then secs=${2:-}; shift 2; fi
    [[ $# -ge 1 ]] || { echo "usage: $0 call [-s seconds] <caller>" >&2; exit 2; }
    caller="$*"
    # the app sends the caller name or number as a type 03 push, then F2 03 00 when the call ends
    mapfile -t cmds < <(push_cmds 03 "$caller")
    write_cmds "${cmds[@]}"
    echo "ringing: $caller"
    sleep "$secs"
    write_cmds f20300
    echo "call ended" ;;
  alarms)
    # 0C <any enabled> then 3 slots of <on> <hour> <min> <days>
    # days: bit 0 = Sunday, bit 1 = Monday ... bit 6 = Saturday
    file=${2:-$(dirname "$0")/alarms.txt}
    days=(SUN MON TUE WED THU FRI SAT)
    declare -A mask=()
    while read -r day times; do
      [[ -z $day ]] && continue
      idx=-1
      for i in "${!days[@]}"; do [[ ${days[i]} == "${day^^}" ]] && idx=$i; done
      (( idx >= 0 )) || { echo "unknown day: $day" >&2; exit 2; }
      for t in $times; do
        [[ $t =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { echo "bad time: $t" >&2; exit 2; }
        key=$(printf '%02d:%02d' $((10#${BASH_REMATCH[1]})) $((10#${BASH_REMATCH[2]})))
        mask[$key]=$(( ${mask[$key]:-0} | 1 << idx ))
      done
    done < <(sed 's/#.*//' "$file")
    mapfile -t keys < <(printf '%s\n' "${!mask[@]}" | grep . | sort)
    (( ${#keys[@]} <= 3 )) || { echo "too many distinct times: ${#keys[@]} (max 3): ${keys[*]}" >&2; exit 2; }
    cmd=$(printf '0c%02x' $(( ${#keys[@]} > 0 )))
    for ((slot = 0; slot < 3; slot++)); do
      if (( slot < ${#keys[@]} )); then
        k=${keys[slot]}; m=${mask[$k]}
        on=""; for i in 1 2 3 4 5 6 0; do (( m >> i & 1 )) && on+="${days[i]} "; done
        echo "slot $((slot + 1)): $k  $on"
        cmd+=$(printf '01%02x%02x%02x' $((10#${k%:*})) $((10#${k#*:})) "$m")
      else
        cmd+=00000000   # disabled
      fi
    done
    write_cmds "$cmd"
    echo "alarms written" ;;
  vibration)
    write_cmds "010$(onoff "${2:-}")" ;;
  longsit)
    # 07 <on> <interval minutes u16 LE>
    on=$(onoff "${2:-}"); mins=${3:-60}
    write_cmds "$(printf '07%02x%02x%02x' "$on" $((mins & 255)) $((mins >> 8)))" ;;
  selfie)
    write_cmds "090$(onoff "${2:-}")" ;;
  profile)
    shift
    # defaults are the app's
    declare -A p=([gender]=male [age]=20 [height]=170 [weight]=60 [steps]=8000 [unit]=km [hand]=left)
    parse_kv p "$@"
    case ${p[gender]} in male) g=0 ;; female) g=1 ;; *) echo "gender: male|female" >&2; exit 2 ;; esac
    case ${p[unit]} in km) u=0 ;; mi) u=1 ;; *) echo "unit: km|mi" >&2; exit 2 ;; esac
    case ${p[hand]} in left) h=0 ;; right) h=1 ;; *) echo "hand: left|right" >&2; exit 2 ;; esac
    # F1 01 <gender> <age> <height cm> <weight kg> <hand> <unit> <step goal u16 LE>
    write_cmds "$(printf 'f101%02x%02x%02x%02x%02x%02x%02x%02x' $g "${p[age]}" "${p[height]}" "${p[weight]}" $h $u \
      $((p[steps] & 255)) $((p[steps] >> 8)))" ;;
  display)
    shift
    declare -A p=([format]=time [lift]=off [lang]=it [bp]=off)
    parse_kv p "$@"
    case ${p[format]} in time) f=0 ;; datetime) f=1 ;; *) echo "format: time|datetime" >&2; exit 2 ;; esac
    # language codes from the app's per-locale language_code resource
    declare -A langs=([en]=0 [zh]=1 [es]=2 [fr]=3 [pt]=4 [ja]=5 [de]=6 [nl]=7 [ru]=8 [pl]=9 [tr]=10
                      [cs]=11 [ms]=12 [sk]=12 [th]=14 [ar]=15 [zh-tw]=16 [it]=17 [ko]=18)
    [[ -n ${langs[${p[lang]}]:-} ]] || { echo "lang: ${!langs[*]}" >&2; exit 2; }
    # F1 02 01 <format> 01 01 01 01 01 <lift to view> 01 01 <language> <blood pressure>
    write_cmds "$(printf 'f10201%02x0101010101%02x0101%02x%02x' $f "$(onoff "${p[lift]}")" "${langs[${p[lang]}]}" \
      "$(onoff "${p[bp]}")")" ;;
  live)
    listen live "${2:-60}" ;;
  sync)
    listen sync 30 ;;
  reset)
    [[ ${2:-} == --yes ]] || { echo "this restores factory settings; run: $0 reset --yes" >&2; exit 2; }
    write_cmds f1031801 ;;
  raw)
    shift; write_cmds "$@" ;;
  status)
    echo "bluez: connected $(prop Connected)  services $(prop ServicesResolved)  rssi $(prop RSSI)"
    if linked; then echo "controller: link up"; else echo "controller: no link"; fi ;;
  ota-probe)
    # read-only: listen to fd02 OTA notifications; default 20 s
    ota_probe "${2:-20}" ;;
  ota-flash)
    shift
    if [[ ${1:-} == --help || -z ${1:-} ]]; then
      sed -n '/^# Maxscend OTA firmware flash/,/owner.s go\.$/p' "$0" | sed 's/^# \{0,1\}//'
      echo "usage: $0 ota-flash <image.bin> [--dry-run|--commit] [--yes]"
      echo "  <image.bin>  OTA image with 16-byte header (e.g. firmware/build/app-ota.bin)"
      echo "  (no mode)    handshake only: version + cmd01 + cmd02, no flash writes, safe"
      echo "  --dry-run    stream code + WRONG crc32 (device should reject); needs --yes"
      echo "  --commit     real flash, valid crc32, device reboots onto it; needs --yes"
      exit 2
    fi
    img=$1; shift
    mode=handshake; yes=
    for a in "$@"; do
      case $a in
        --dry-run) mode=dry-run ;;
        --commit)  mode=commit ;;
        --yes)     yes=--yes ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
      esac
    done
    ota_flash "$img" "$mode" "$yes" ;;
  keepalive)
    # probe with a cc02 read; gatt() reconnects and recovers on its own
    every=${2:-10}
    while :; do
      if out=$(gatt cc02 ReadValue 'a{sv}' 0); then
        [[ ${up:-} == 1 ]] || log "link up"
        up=1
      else
        log "link down, still trying"
        up=0
      fi
      sleep "$every"
    done ;;
  read)
    [[ $# -eq 2 ]] || { echo "usage: $0 read <uuid>" >&2; exit 2; }
    # shellcheck disable=SC2046
    printf '%02x ' $(read_char "$2"); echo ;;
  *)
    sed -n '2,41p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
